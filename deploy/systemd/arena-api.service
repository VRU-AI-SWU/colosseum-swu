# Arena — API + worker (process เดียว ดู docs/architecture.md §1)
#
#   sudo cp deploy/systemd/arena-api.service /etc/systemd/system/
#   sudo systemctl enable --now arena-api
#
# แก้ User=, WorkingDirectory= และ path ทั้งหมดให้ตรงกับเครื่อง
# ค่าที่ใส่ไว้คือ ratchainant + ระบบอยู่บน SSD / ข้อมูลใหญ่อยู่บน HDD "colosseum"

[Unit]
Description=Arena API + worker (Colosseum)
# ต้องรอ docker ให้พร้อมก่อน ไม่งั้น --real-seeds จะไม่ยอมเริ่มเพราะหา image ไม่เจอ
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ratchainant
WorkingDirectory=/home/ratchainant/VRU-AI/projects/colosseum/app

# Python buffer stdout เมื่อปลายทางไม่ใช่ terminal — บรรทัดสถานะตอนสตาร์ท
# (sandbox ที่ใช้ · ล็อกอินตั้งค่าหรือยัง · โหลดข้อมูลเก่ามาได้เท่าไร) จึงไม่โผล่ใน
# journal จนกว่า buffer จะเต็มหรือ process จบ ซึ่งคือตอนที่สายเกินจะช่วยอะไร
Environment=PYTHONUNBUFFERED=1

# seed อยู่ที่นี่ที่เดียว — ไม่มีสำเนาบน cloud (README §10.4)
Environment=ARENA_SECRETS=/home/ratchainant/VRU-AI/projects/colosseum/secrets

# client secret ของ Google อยู่ในไฟล์นี้ **ไม่ใช่ใน unit** เพราะ unit ถูก commit
# ลง repo สาธารณะ · ไฟล์ต้องเป็นของ root โหมด 600 — systemd อ่านตอนยังเป็น root
# ก่อนจะ drop สิทธิ์ลงเป็น User= จึงไม่ต้องให้ผู้ใช้บริการอ่านได้เอง
#
#   ARENA_GOOGLE_CLIENT_ID
#   ARENA_GOOGLE_CLIENT_SECRET
#   ARENA_WEB_ORIGIN
#
# `-` ข้างหน้าแปลว่าไฟล์ไม่มีก็ยังสตาร์ทได้ — ระบบยังทำงานได้โดยไม่มีล็อกอิน
# (endpoint ที่ต้องใช้จะตอบ 503 พร้อมบอกว่าต้องตั้งตัวแปรไหน) ซึ่งดีกว่าบริการ
# ไม่ยอมขึ้นทั้งตัวเพราะยังไม่ได้ตั้งค่าส่วนที่เป็นทางเลือก
EnvironmentFile=-/etc/arena.env

# --host 127.0.0.1 ไม่ใช่ 0.0.0.0 โดยตั้งใจ: ทางเข้าเดียวคือผ่าน tunnel
# ถ้า bind กว้างกว่านี้ ใครที่อยู่บนเครือข่ายมหาวิทยาลัยจะยิง API ได้ตรงๆ
# โดยข้าม Cloudflare ทั้งหมด ทำให้ rate limit และ Access ที่จะใส่ทีหลังไร้ความหมาย
#
# ไม่ต้องใส่ --sandbox เพราะ --real-seeds บังคับ Docker อยู่แล้ว
# ทั้ง arena.db และ artifacts อยู่บน SSD — HDD เป็นที่สำรองอย่างเดียว (ดู deploy/README.md)
# ถ้าวันหนึ่ง SSD ไม่พอ ย้ายเฉพาะ artifacts ได้ด้วย --artifacts /path/to/hdd/artifacts
ExecStart=/home/ratchainant/VRU-AI/projects/colosseum/app/.venv/bin/python -m core.cli serve \
    --host 127.0.0.1 \
    --port 8000 \
    --data /home/ratchainant/VRU-AI/projects/colosseum/data \
    --real-seeds \
    --allow-origin https://colosseum.vru-ai.com

Restart=always
RestartSec=5
# ให้ worker รันงานที่ค้างอยู่จนจบก่อนตาย — งานหนึ่งใช้เวลาไม่ถึงนาที
KillSignal=SIGTERM
TimeoutStopSec=120

# ลดผลกระทบถ้าวันหนึ่งมีช่องโหว่ในตัว API เอง
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ProtectHome=read-only ใช้ไม่ได้เพราะทั้งระบบอยู่ใน home — ระบุ path ที่เขียนได้แทน
ReadWritePaths=/home/ratchainant/VRU-AI/projects/colosseum/data

# ไม่ต้อง RequiresMountsFor เพราะบริการนี้ไม่แตะ HDD เลย — การสำรองแยกไปอยู่ที่
# arena-backup.service ซึ่งมี RequiresMountsFor ของตัวเอง

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
