# สำรองข้อมูลทุกคืน
#
# ตี 3 เพราะเป็นเวลาที่นิสิตส่งงานน้อยที่สุด — การสำรองไม่บล็อกการเขียนอยู่แล้ว
# (SQLite backup API อ่านทีละ page) แต่ rsync ของ artifacts กินแบนด์วิดท์ดิสก์

[Unit]
Description=สำรองข้อมูล Arena ทุกคืน

[Timer]
OnCalendar=*-*-* 03:00:00
# เครื่องปิดอยู่ตอนถึงเวลา → รันทันทีที่เปิดกลับมา · ไม่งั้นไฟดับคืนหนึ่ง
# แปลว่าข้ามการสำรองไปทั้งวันโดยไม่มีใครรู้
Persistent=true
# กระจายเวลาเล็กน้อย กันชนกับงานอื่นที่ตั้งเวลาตรงกันพอดี
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
