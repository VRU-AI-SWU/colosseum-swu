#!/usr/bin/env python3
"""กันไม่ให้ค่า seed ที่เป็นความลับหลุดเข้า repo สาธารณะ

repo นี้เป็น public · ค่า seed ของ public/private eval อยู่ที่ `colosseum-hypogeum` ซึ่งเป็น private
กฎ "ห้ามเอาออกจาก repo นั้น" เป็นวินัย — hook นี้ทำให้มันเป็น **การป้องกันเชิงโครงสร้าง**
ตามหลักการเดียวกับ README §10.4

ตรวจ 2 อย่างในสิ่งที่ staged ไว้
  1. ชื่อไฟล์ที่ไม่ควรอยู่ใน repo นี้ (`seeds.yaml`, อะไรก็ตามที่มีคำว่า hypogeum/diamond)
  2. บรรทัดที่เพิ่มเข้ามา มีตัวเลขที่ตรงกับค่า seed ลับตัวใดตัวหนึ่ง

ติดตั้ง (ครั้งเดียวต่อ clone)
    git config core.hooksPath tools/hooks

ตรวจว่า hook ยังทำงานอยู่
    tools/hooks/pre-commit --selftest

⚠️ **ถ้าโดนฟ้องเพราะเลขบังเอิญตรงกัน ให้เปลี่ยนเลขนั้น ไม่ใช่ทำ allowlist**
การใส่เลขลงไฟล์ allowlist ใน repo สาธารณะ = ประกาศว่าเลขนั้นเป็น seed ซึ่งคือสิ่งที่เรากำลังกันอยู่พอดี
(โอกาสชนกันเองอยู่ที่ราว 0.5% ต่อเลข 5 หลักหนึ่งตัว — เจอแล้วเปลี่ยนเลขง่ายกว่า)
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

TOKEN = re.compile(r"\b\d{5}\b")
SUSPICIOUS_PATH = re.compile(r"(^|/)seeds[^/]*\.ya?ml$|hypogeum|/diamond/", re.IGNORECASE)

YELLOW, RED, GREEN, RESET = "\033[33m", "\033[31m", "\033[32m", "\033[0m"


def repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    )
    return Path(out.stdout.strip())


def find_hypogeum(root: Path) -> Path | None:
    """หา repo ของลับ — ตัวแปรแวดล้อมก่อน แล้วค่อยเดาจากตำแหน่งข้างๆ"""
    env = os.environ.get("ARENA_HYPOGEUM")
    candidates = [Path(env)] if env else []
    candidates.append(root.parent / "colosseum-hypogeum")
    for c in candidates:
        if c.is_dir():
            return c
    return None


def load_secret_seeds(hypogeum: Path) -> set[int]:
    """อ่านเฉพาะ `phases.*.public` และ `phases.*.private` — ไม่เอา `bands` ซึ่งเปิดเผยได้"""
    try:
        import yaml
    except ImportError:
        print(
            f"{YELLOW}pre-commit: ไม่มี pyyaml ใน {sys.executable} — ตรวจ seed ไม่ได้{RESET}\n"
            f"  ติดตั้งด้วย: {sys.executable} -m pip install pyyaml",
            file=sys.stderr,
        )
        return set()

    seeds: set[int] = set()
    for path in sorted(hypogeum.rglob("seeds*.yaml")):
        try:
            data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        except Exception as exc:  # ไฟล์เสียไม่ควรทำให้ commit ไม่ได้ แต่ต้องรู้
            print(f"{YELLOW}pre-commit: อ่าน {path.name} ไม่ได้ ({exc}){RESET}", file=sys.stderr)
            continue
        for phase in (data.get("phases") or {}).values():
            for kind in ("public", "private"):
                seeds.update(int(v) for v in (phase.get(kind) or []))
    return seeds


def staged_paths() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True, text=True, check=True,
    )
    return [p for p in out.stdout.splitlines() if p]


def staged_additions() -> list[tuple[str, int, str]]:
    """คืน (path, เลขบรรทัด, เนื้อบรรทัด) ของทุกบรรทัดที่ **เพิ่มเข้ามา** เท่านั้น"""
    out = subprocess.run(
        ["git", "diff", "--cached", "-U0", "--diff-filter=ACMR", "--no-color"],
        capture_output=True, text=True, check=True,
    )
    added: list[tuple[str, int, str]] = []
    path, lineno = "", 0
    for line in out.stdout.splitlines():
        if line.startswith("+++ b/"):
            path, lineno = line[6:], 0
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            lineno = int(m.group(1)) if m else 0
        elif line.startswith("+") and not line.startswith("+++"):
            added.append((path, lineno, line[1:]))
            lineno += 1
    return added


def mask(value: int) -> str:
    """ไม่พิมพ์ค่าเต็มลง terminal/CI log — file:line พอให้หาเจอแล้ว"""
    s = str(value)
    return s[0] + "*" * (len(s) - 2) + s[-1]


def check() -> int:
    root = repo_root()
    problems: list[str] = []

    for path in staged_paths():
        if SUSPICIOUS_PATH.search(path):
            problems.append(f"  {path} — ไฟล์ชนิดนี้ไม่ควรอยู่ใน repo สาธารณะ")

    hypogeum = find_hypogeum(root)
    if hypogeum is None:
        print(
            f"{YELLOW}pre-commit: หา colosseum-hypogeum ไม่เจอ — ข้ามการตรวจค่า seed{RESET}\n"
            f"  ถ้าอยู่ที่อื่น ตั้ง ARENA_HYPOGEUM=/path/to/colosseum-hypogeum",
            file=sys.stderr,
        )
        secrets: set[int] = set()
    else:
        secrets = load_secret_seeds(hypogeum)

    if secrets:
        for path, lineno, text in staged_additions():
            for token in TOKEN.findall(text):
                if int(token) in secrets:
                    problems.append(
                        f"  {path}:{lineno} — มีเลขที่ตรงกับ seed ลับ ({mask(int(token))})"
                    )

    if not problems:
        return 0

    print(
        f"\n{RED}✗ commit ถูกปฏิเสธ — พบของที่ไม่ควรอยู่ใน repo สาธารณะ{RESET}\n"
        + "\n".join(problems)
        + f"\n\n{YELLOW}วิธีแก้{RESET}\n"
        "  · ถ้าเป็นค่า seed จริง — เอาออก แล้วเก็บไว้ที่ colosseum-hypogeum แทน\n"
        "  · ถ้าเป็นเลขอื่นที่บังเอิญตรงกัน — **เปลี่ยนเลขนั้น** อย่าทำ allowlist\n"
        "    (การใส่เลขลง allowlist ใน repo สาธารณะ = ประกาศว่าเลขนั้นเป็น seed)\n"
        "  · ถ้ามั่นใจจริงๆ ว่าปลอดภัย — `git commit --no-verify` แต่ต้องรู้ว่ากำลังทำอะไร\n",
        file=sys.stderr,
    )
    return 1


def selftest() -> int:
    """ยืนยันว่า hook ยังจับของได้จริง — hook ที่พังเงียบๆ แย่กว่าไม่มี hook"""
    root = repo_root()
    hypogeum = find_hypogeum(root)
    if hypogeum is None:
        print(f"{RED}✗ หา colosseum-hypogeum ไม่เจอ — hook ตรวจอะไรไม่ได้เลย{RESET}")
        return 1
    secrets = load_secret_seeds(hypogeum)
    if not secrets:
        print(f"{RED}✗ โหลดค่า seed ไม่ได้สักตัว — hook ใช้งานไม่ได้{RESET}")
        return 1

    sample = sorted(secrets)[0]
    if not TOKEN.findall(f"seed = {sample}"):
        print(f"{RED}✗ regex จับเลข seed ไม่ได้{RESET}")
        return 1
    if TOKEN.findall("sha256:08559dc77c2a3dc598b3f87e7442db513fea66e6949b"):
        print(f"{RED}✗ regex จับตัวเลขในค่า hash ซึ่งจะทำให้ฟ้องผิด{RESET}")
        return 1

    print(
        f"{GREEN}✓ hook ทำงานได้{RESET}\n"
        f"  hypogeum: {hypogeum}\n"
        f"  โหลด seed ลับได้ {len(secrets)} ค่า จาก {len(list(hypogeum.rglob('seeds*.yaml')))} ไฟล์"
    )
    return 0


if __name__ == "__main__":
    sys.exit(selftest() if "--selftest" in sys.argv else check())
